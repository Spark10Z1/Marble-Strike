config_version=5

[application]

config/name="Marbles_v2"
run/main_scene="uid://b40lndu5gpwks"
config/features=PackedStringArray("4.8", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

global="*uid://4ava3x50i6mv"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[physics]

3d/physics_engine="Jolt Physics"
2d/default_gravity_vector=Vector2(0, 0)
2d/default_linear_damp=1.5

[rendering]

