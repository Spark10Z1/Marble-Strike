; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Marbles_v2.1"
run/main_scene="uid://b40lndu5gpwks"
config/features=PackedStringArray("4.8", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

global="*uid://4ava3x50i6mv"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[layer_names]

2d_render/layer_1="PlayerArea"
2d_render/layer_2="Marbles"
2d_render/layer_3="Shooter"
2d_render/layer_4="Border"
2d_physics/layer_1="PlayArea"
2d_physics/layer_2="Marbles"
2d_physics/layer_3="Shooter"
2d_physics/layer_4="Border"
2d_physics/layer_5="Collider"

[physics]

3d/physics_engine="Jolt Physics"
2d/default_gravity_vector=Vector2(0, 0)
2d/default_linear_damp=2.0

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=true
